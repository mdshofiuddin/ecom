<%- include('../../partials/header') %>

<div style="margin-bottom: 2rem;">
  <a href="/admin/dashboard" style="color: var(--text-secondary); font-size: 0.85rem;">&larr; Admin Command</a>
  <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; margin-top: 0.25rem;">
    Security Audit Logs
  </h1>
  <p style="color: var(--text-secondary);">Immutable historical trail of authentication, authorization, CSRF, and rate limit events.</p>
</div>

<div class="data-table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Event Classification</th>
        <th>User ID</th>
        <th>Client IP</th>
        <th>Event Payload / Details</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody>
      <% logs.forEach(log => { %>
        <tr>
          <td>#<%= log.id %></td>
          <td>
            <% if (log.event_type.includes('BLOCKED') || log.event_type.includes('FAILED') || log.event_type.includes('ATTEMPT')) { %>
              <span class="status-badge status-cancelled"><%= log.event_type %></span>
            <% } else if (log.event_type.includes('SUCCESS') || log.event_type.includes('REGISTERED')) { %>
              <span class="status-badge status-delivered"><%= log.event_type %></span>
            <% } else { %>
              <span class="status-badge status-processing"><%= log.event_type %></span>
            <% } %>
          </td>
          <td><%= log.user_id ? `User #${log.user_id}` : 'Guest / System' %></td>
          <td><code><%= log.ip_address %></code></td>
          <td style="color: var(--text-secondary); font-family: monospace; font-size: 0.85rem;"><%= log.details %></td>
          <td style="color: var(--text-muted); font-size: 0.8rem;"><%= new Date(log.created_at).toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/footer') %>
