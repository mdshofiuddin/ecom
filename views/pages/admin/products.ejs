<%- include('../../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <a href="/admin/dashboard" style="color: var(--text-secondary); font-size: 0.85rem;">&larr; Admin Command</a>
    <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; margin-top: 0.25rem;">
      Product Catalog & Inventory
    </h1>
  </div>

  <a href="/admin/products/new" class="btn btn-primary" id="admin-create-product-btn">
    + Add New Product
  </a>
</div>

<div class="data-table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Image</th>
        <th>Product Title</th>
        <th>Category</th>
        <th>Price</th>
        <th>Stock Level</th>
        <th>Featured</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(prod => { %>
        <tr>
          <td style="width: 60px;">
            <img src="<%= prod.image_url %>" alt="<%= prod.name %>" style="width: 48px; height: 48px; border-radius: var(--radius-sm); object-fit: cover;">
          </td>
          <td>
            <div style="font-weight: 700;"><%= prod.name %></div>
            <div style="color: var(--text-muted); font-size: 0.78rem;">Slug: <%= prod.slug %></div>
          </td>
          <td><%= prod.category %></td>
          <td><strong>$<%= prod.price.toFixed(2) %></strong></td>
          <td>
            <% if (prod.stock <= 5) { %>
              <span class="product-stock-tag low" style="position: static;"><%= prod.stock %> units</span>
            <% } else { %>
              <span class="product-stock-tag" style="position: static;"><%= prod.stock %> units</span>
            <% } %>
          </td>
          <td>
            <% if (prod.featured) { %>
              <span style="color: var(--accent-emerald); font-weight: 700;">Yes</span>
            <% } else { %>
              <span style="color: var(--text-muted);">No</span>
            <% } %>
          </td>
          <td>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
              <a href="/admin/products/edit/<%= prod.id %>" class="btn btn-secondary btn-sm">Edit</a>
              <form action="/admin/products/delete/<%= prod.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');" style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/footer') %>
