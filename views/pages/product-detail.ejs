<%- include('../partials/header') %>

<div style="margin-bottom: 1.5rem;">
  <a href="/shop" style="color: var(--text-secondary); font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.4rem;">
    &larr; Back to Catalog
  </a>
</div>

<div class="detail-layout">
  <div class="detail-gallery">
    <img src="<%= product.image_url %>" alt="<%= product.name %>" class="detail-img">
  </div>

  <div class="detail-info">
    <span class="product-category"><%= product.category %></span>
    <h1 class="detail-title"><%= product.name %></h1>

    <div class="detail-price-box">
      <div class="detail-price">$<%= product.price.toFixed(2) %></div>
      <% if (product.stock > 0) { %>
        <span class="product-stock-tag" style="position: static;">
          Available: <%= product.stock %> units
        </span>
      <% } else { %>
        <span class="product-stock-tag low" style="position: static; background: rgba(244, 63, 94, 0.2); color: #fb7185;">
          Out of Stock
        </span>
      <% } %>
    </div>

    <p class="detail-desc"><%= product.description %></p>

    <% if (product.stock > 0) { %>
      <form action="/cart/add" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= product.id %>">
        
        <div style="margin-bottom: 1.5rem;">
          <label class="form-label">Select Quantity:</label>
          <div style="display: flex; gap: 1rem; align-items: center;">
            <input 
              type="number" 
              name="quantity" 
              value="1" 
              min="1" 
              max="<%= product.stock %>" 
              class="qty-input"
              id="detail-qty-input"
            >
            <button type="submit" class="btn btn-primary btn-lg" id="detail-add-to-cart-btn" style="flex: 1;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              Add to Shopping Bag
            </button>
          </div>
        </div>
      </form>
    <% } else { %>
      <div class="alert alert-error">
        <span>This product is currently out of stock. Check back soon!</span>
      </div>
    <% } %>

    <div style="margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-secondary);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-emerald);">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>2-Year Comprehensive Manufacturer Warranty</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-secondary);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-cyan);">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
        <span>Free Priority Insured Shipping on orders over $150</span>
      </div>
    </div>
  </div>
</div>

<!-- Related Products -->
<% if (related && related.length > 0) { %>
  <section style="margin-top: 3.5rem;">
    <h2 class="section-title" style="margin-bottom: 1.5rem;">Recommended in <%= product.category %></h2>
    <div class="product-grid">
      <% related.forEach(rel => { %>
        <div class="product-card">
          <div class="product-img-wrap">
            <a href="/products/<%= rel.slug %>">
              <img src="<%= rel.image_url %>" alt="<%= rel.name %>" class="product-img" loading="lazy">
            </a>
          </div>
          <div class="product-body">
            <h3 class="product-name">
              <a href="/products/<%= rel.slug %>"><%= rel.name %></a>
            </h3>
            <div class="product-footer">
              <div class="product-price">$<%= rel.price.toFixed(2) %></div>
              <a href="/products/<%= rel.slug %>" class="btn btn-secondary btn-sm">View Item</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<%- include('../partials/footer') %>
