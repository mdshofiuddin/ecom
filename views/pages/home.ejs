<%- include('../partials/header') %>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-tag">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
      </svg>
      <span>Next-Gen Audio & Computing Gear</span>
    </div>

    <h1 class="hero-title">
      Engineering Excellence. <span>Zero Compromises.</span>
    </h1>

    <p class="hero-desc">
      Discover precision instruments, audiophile acoustics, and high-performance developer hardware. Built with full architectural integrity and hardened security.
    </p>

    <div class="hero-btns">
      <a href="/shop" class="btn btn-primary btn-lg" id="hero-shop-cta">
        Shop Catalog
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
      <% if (!currentUser) { %>
        <a href="/auth/login" class="btn btn-secondary btn-lg" id="hero-login-cta">Sign In Demo</a>
      <% } else if (isAdmin) { %>
        <a href="/admin/dashboard" class="btn btn-secondary btn-lg" id="hero-admin-cta" style="border-color: var(--accent-amber); color: var(--accent-amber);">
          Open Admin Panel
        </a>
      <% } %>
    </div>

    <div class="hero-badges">
      <div class="badge-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Bank-Grade Encryption</span>
      </div>
      <div class="badge-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
        <span>Express Delivery</span>
      </div>
      <div class="badge-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span>Verified Inventory</span>
      </div>
    </div>
  </div>
</section>

<!-- Category Filter Pills -->
<div class="category-strip">
  <a href="/shop" class="category-pill active">All Categories</a>
  <% categories.forEach(cat => { %>
    <a href="/shop?category=<%= encodeURIComponent(cat) %>" class="category-pill"><%= cat %></a>
  <% }) %>
</div>

<!-- Featured Products Section -->
<section style="margin-bottom: 4rem;">
  <div class="section-header">
    <div>
      <h2 class="section-title">Flagship Innovations</h2>
      <p class="section-subtitle">Hand-picked, high-demand devices with verified stock</p>
    </div>
    <a href="/shop" class="btn btn-secondary btn-sm" id="view-all-featured-btn">
      View All Catalog &rarr;
    </a>
  </div>

  <div class="product-grid">
    <% featuredProducts.forEach(product => { %>
      <div class="product-card">
        <div class="product-img-wrap">
          <a href="/products/<%= product.slug %>">
            <img src="<%= product.image_url %>" alt="<%= product.name %>" class="product-img" loading="lazy">
          </a>
          <span class="product-featured-tag">FEATURED</span>
          <% if (product.stock <= 5) { %>
            <span class="product-stock-tag low">Only <%= product.stock %> left</span>
          <% } else { %>
            <span class="product-stock-tag">In Stock (<%= product.stock %>)</span>
          <% } %>
        </div>

        <div class="product-body">
          <span class="product-category"><%= product.category %></span>
          <h3 class="product-name">
            <a href="/products/<%= product.slug %>"><%= product.name %></a>
          </h3>
          <p class="product-desc"><%= product.description %></p>

          <div class="product-footer">
            <div class="product-price">$<%= product.price.toFixed(2) %></div>
            <form action="/cart/add" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="productId" value="<%= product.id %>">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="btn btn-primary btn-sm" id="add-to-cart-<%= product.id %>">
                Add to Bag
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<%- include('../partials/footer') %>
