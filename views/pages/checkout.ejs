<%- include('../partials/header') %>

<div style="margin-bottom: 2.5rem;">
  <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem;">
    Encrypted Checkout
  </h1>
  <p style="color: var(--text-secondary);">Direct end-to-end encrypted order transmission. Inventory is locked upon submission.</p>
</div>

<div class="cart-layout">
  <!-- Checkout Form -->
  <div class="cart-table-card">
    <form action="/checkout" method="POST" id="checkout-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <span style="display: flex; align-items: center; justify-content: center; width: 1.8rem; height: 1.8rem; border-radius: 50%; background: var(--accent-primary); color: #fff; font-size: 0.85rem;">1</span>
        Contact & Shipping Details
      </h3>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label class="form-label" for="customer_name">Recipient Full Name *</label>
          <input 
            type="text" 
            name="customer_name" 
            id="customer_name" 
            class="form-input" 
            required 
            value="<%= (formData && formData.customer_name) ? formData.customer_name : '' %>"
            placeholder="e.g. John Doe"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="customer_email">Email Confirmation *</label>
          <input 
            type="email" 
            name="customer_email" 
            id="customer_email" 
            class="form-input" 
            required 
            value="<%= (formData && formData.customer_email) ? formData.customer_email : '' %>"
            placeholder="john@example.com"
          >
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="shipping_address">Delivery Street Address *</label>
        <input 
          type="text" 
          name="shipping_address" 
          id="shipping_address" 
          class="form-input" 
          required 
          value="<%= (formData && formData.shipping_address) ? formData.shipping_address : '' %>"
          placeholder="e.g. 742 Evergreen Terrace, Suite 100"
        >
      </div>

      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label class="form-label" for="city">City / Region *</label>
          <input 
            type="text" 
            name="city" 
            id="city" 
            class="form-input" 
            required 
            value="<%= (formData && formData.city) ? formData.city : '' %>"
            placeholder="e.g. New York"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="postal_code">Postal Code *</label>
          <input 
            type="text" 
            name="postal_code" 
            id="postal_code" 
            class="form-input" 
            required 
            value="<%= (formData && formData.postal_code) ? formData.postal_code : '' %>"
            placeholder="10001"
          >
        </div>
      </div>

      <h3 style="font-size: 1.25rem; font-weight: 700; margin: 2rem 0 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <span style="display: flex; align-items: center; justify-content: center; width: 1.8rem; height: 1.8rem; border-radius: 50%; background: var(--accent-cyan); color: #000; font-size: 0.85rem;">2</span>
        Payment Guarantee
      </h3>

      <div class="form-group">
        <label class="form-label" for="card_number">Card Number *</label>
        <input 
          type="text" 
          name="card_number" 
          id="card_number" 
          class="form-input" 
          required 
          placeholder="4532 0000 1234 5678" 
          value="4532000012345678"
        >
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label class="form-label" for="card_expiry">Expiry (MM/YY) *</label>
          <input 
            type="text" 
            name="card_expiry" 
            id="card_expiry" 
            class="form-input" 
            required 
            placeholder="12/28" 
            value="12/28"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="card_cvv">Security Code (CVV) *</label>
          <input 
            type="password" 
            name="card_cvv" 
            id="card_cvv" 
            class="form-input" 
            required 
            maxlength="4" 
            placeholder="987" 
            value="987"
          >
        </div>
      </div>

      <div style="margin-top: 2rem;">
        <button type="submit" class="btn btn-primary btn-lg btn-full" id="submit-order-btn">
          Confirm & Pay $<%= total.toFixed(2) %>
        </button>
      </div>
    </form>
  </div>

  <!-- Order Items Preview -->
  <div class="summary-card">
    <h3 class="summary-title">Summary Review</h3>

    <div style="margin-bottom: 1.5rem; max-height: 260px; overflow-y: auto;">
      <% cartItems.forEach(item => { %>
        <div style="display: flex; gap: 1rem; margin-bottom: 1rem; align-items: center;">
          <img src="<%= item.product.image_url %>" alt="<%= item.product.name %>" style="width: 50px; height: 50px; border-radius: var(--radius-sm); object-fit: cover;">
          <div style="flex: 1; font-size: 0.88rem;">
            <div style="font-weight: 600;"><%= item.product.name %></div>
            <div style="color: var(--text-secondary); font-size: 0.8rem;">Qty: <%= item.quantity %> &times; $<%= item.product.price.toFixed(2) %></div>
          </div>
          <div style="font-weight: 700; font-size: 0.95rem;">$<%= item.subtotal.toFixed(2) %></div>
        </div>
      <% }) %>
    </div>

    <div class="summary-row">
      <span>Subtotal</span>
      <span>$<%= subtotal.toFixed(2) %></span>
    </div>

    <div class="summary-row">
      <span>Shipping</span>
      <% if (shipping === 0) { %>
        <span style="color: var(--accent-emerald); font-weight: 700;">FREE</span>
      <% } else { %>
        <span>$<%= shipping.toFixed(2) %></span>
      <% } %>
    </div>

    <div class="summary-row">
      <span>Sales Tax (5%)</span>
      <span>$<%= tax.toFixed(2) %></span>
    </div>

    <div class="summary-row total">
      <span>Final Total</span>
      <span style="color: var(--accent-cyan);">$<%= total.toFixed(2) %></span>
    </div>

    <div style="margin-top: 2rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1rem; font-size: 0.8rem; color: var(--text-secondary);">
      <div style="font-weight: 700; color: #fff; margin-bottom: 0.35rem;">🛡️ Fraud & Anti-Tamper Shield</div>
      <div>Item prices and availability are verified against our database during order creation. Client alterations are rejected automatically.</div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
