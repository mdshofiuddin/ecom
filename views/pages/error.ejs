<%- include('../partials/header') %>

<div class="form-card" style="text-align: center; max-width: 600px; padding: 3.5rem 2rem;">
  <div style="display: inline-flex; align-items: center; justify-content: center; width: 4.5rem; height: 4.5rem; border-radius: 50%; background: rgba(244, 63, 94, 0.15); color: var(--accent-rose); margin-bottom: 1.5rem; border: 1px solid rgba(244, 63, 94, 0.3);">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
  </div>

  <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.75rem; letter-spacing: -0.02em;">
    <%= statusCode || 500 %>
  </h1>
  <h2 style="font-size: 1.25rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 1.25rem;">
    <%= title || 'System Notice' %>
  </h2>

  <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 2rem;">
    <%= errorMessage || 'An unexpected condition was encountered.' %>
  </p>

  <% if (typeof errorStack !== 'undefined' && errorStack) { %>
    <pre style="text-align: left; background: var(--bg-primary); padding: 1rem; border-radius: var(--radius-sm); font-size: 0.75rem; color: #fca5a5; overflow-x: auto; margin-bottom: 2rem; border: 1px solid var(--border-color);">
<%= errorStack %>
    </pre>
  <% } %>

  <div style="display: flex; gap: 1rem; justify-content: center;">
    <a href="/" class="btn btn-primary" id="error-home-btn">Return to Safety</a>
    <a href="/shop" class="btn btn-secondary" id="error-shop-btn">Browse Products</a>
  </div>
</div>

<%- include('../partials/footer') %>
